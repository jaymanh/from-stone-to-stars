{
	"schemaVersion": 1,
	"id": "from-stone-to-stars",
	"version": "${version}",
	"name": "From Stone to Stars",
	"description": "A civilisation and technology overhaul. Start with pebbles, flint, and bone, and build the machines that replace that work on the way to a spacefaring industry.",
	"authors": [
		{
			"name": "Jaymanh",
			"contact": {
				"homepage": "https://github.com/jaymanh"
			}
		}
	],
	"contact": {
		"homepage": "https://github.com/jaymanh/from-stone-to-stars",
		"sources": "https://github.com/jaymanh/from-stone-to-stars",
		"issues": "https://github.com/jaymanh/from-stone-to-stars/issues"
	},
	"license": "LGPL-3.0-only",
	"icon": "assets/from-stone-to-stars/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"jaymanh.fsts.FromStoneToStars"
		],
		"client": [
			"jaymanh.fsts.client.FromStoneToStarsClient"
		],
		"fabric-datagen": [
			"jaymanh.fsts.client.FromStoneToStarsDataGenerator"
		],
		"modmenu": [
			"jaymanh.fsts.client.compat.modmenu.ModMenuCompat"
		],
		"jei_mod_plugin": [
			"jaymanh.fsts.client.compat.jei.FstsJeiPlugin"
		],
		"jade": [
			"jaymanh.fsts.client.compat.jade.FstsJadePlugin"
		]
	},
	"mixins": [
		"from-stone-to-stars.mixins.json"
	],
	"depends": {
		"fabricloader": ">=0.19.5",
		"minecraft": "~26.2",
		"java": ">=25",
		"fabric-api": "*"
	},
	"suggests": {
		"modmenu": "*",
		"yet_another_config_lib_v3": "*",
		"jei": "*",
		"emi": "*",
		"jade": "*",
		"wthit": "*",
		"ae2": "*"
	},
	"custom": {
		"modmenu": {
			"links": {
				"modmenu.github_releases": "https://github.com/jaymanh/from-stone-to-stars/releases"
			},
			"update_checker": true
		}
	}
}