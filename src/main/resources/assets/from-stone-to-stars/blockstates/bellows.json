{
  "multipart": [
    { "when": { "facing": "north" }, "apply": { "model": "from-stone-to-stars:block/bellows_core" } },
    { "when": { "facing": "east" }, "apply": { "model": "from-stone-to-stars:block/bellows_core", "y": 90 } },
    { "when": { "facing": "south" }, "apply": { "model": "from-stone-to-stars:block/bellows_core", "y": 180 } },
    { "when": { "facing": "west" }, "apply": { "model": "from-stone-to-stars:block/bellows_core", "y": 270 } },

    { "when": { "north": "true" }, "apply": { "model": "from-stone-to-stars:block/bellows_side" } },
    { "when": { "east": "true" }, "apply": { "model": "from-stone-to-stars:block/bellows_side", "y": 90 } },
    { "when": { "south": "true" }, "apply": { "model": "from-stone-to-stars:block/bellows_side", "y": 180 } },
    { "when": { "west": "true" }, "apply": { "model": "from-stone-to-stars:block/bellows_side", "y": 270 } },

    { "when": { "up": "true" }, "apply": { "model": "from-stone-to-stars:block/bellows_up" } }
  ]
}
