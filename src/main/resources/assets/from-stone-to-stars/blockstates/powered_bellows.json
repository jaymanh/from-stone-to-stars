{
  "multipart": [
    { "when": { "facing": "north", "compressed": "false" }, "apply": { "model": "from-stone-to-stars:block/powered_bellows_core" } },
    { "when": { "facing": "east", "compressed": "false" }, "apply": { "model": "from-stone-to-stars:block/powered_bellows_core", "y": 90 } },
    { "when": { "facing": "south", "compressed": "false" }, "apply": { "model": "from-stone-to-stars:block/powered_bellows_core", "y": 180 } },
    { "when": { "facing": "west", "compressed": "false" }, "apply": { "model": "from-stone-to-stars:block/powered_bellows_core", "y": 270 } },

    { "when": { "facing": "north", "compressed": "true" }, "apply": { "model": "from-stone-to-stars:block/powered_bellows_core_compressed" } },
    { "when": { "facing": "east", "compressed": "true" }, "apply": { "model": "from-stone-to-stars:block/powered_bellows_core_compressed", "y": 90 } },
    { "when": { "facing": "south", "compressed": "true" }, "apply": { "model": "from-stone-to-stars:block/powered_bellows_core_compressed", "y": 180 } },
    { "when": { "facing": "west", "compressed": "true" }, "apply": { "model": "from-stone-to-stars:block/powered_bellows_core_compressed", "y": 270 } },

    { "when": { "north": "true" }, "apply": { "model": "from-stone-to-stars:block/bellows_side" } },
    { "when": { "east": "true" }, "apply": { "model": "from-stone-to-stars:block/bellows_side", "y": 90 } },
    { "when": { "south": "true" }, "apply": { "model": "from-stone-to-stars:block/bellows_side", "y": 180 } },
    { "when": { "west": "true" }, "apply": { "model": "from-stone-to-stars:block/bellows_side", "y": 270 } },

    { "when": { "up": "true" }, "apply": { "model": "from-stone-to-stars:block/bellows_up" } }
  ]
}
